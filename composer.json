{
    "name": "autocar/backend",
    "description": "API JSON de AutoCar (PHP + PostgreSQL en Neon)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "AutoCar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AutoCar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integracion": "phpunit --testsuite integration"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
