# Copiá este archivo como .env (el .env real NO se sube al repo).
# En Render estas variables se cargan en Environment; el .env solo se usa en local.

# Datos de Neon (botón "Connect" de la consola, con "Connection pooling" DESACTIVADO)
DB_HOST=ep-xxxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=
# Con un Postgres local sin SSL: DB_SSLMODE=disable (por defecto es "require")
# DB_SSLMODE=require

# Firma de los tokens JWT. OBLIGATORIO, mínimo 32 caracteres y distinto en local y en producción.
# Generar uno:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Duración del token en segundos (opcional, por defecto 7200 = 2 horas)
# JWT_TTL=7200

# Orígenes del front que pueden llamar a la API (CORS), separados por coma, sin barra final.
FRONT_URL=http://localhost:5173
